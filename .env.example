NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Requires Routes API + Places API (New) enabled in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Cloud Map ID for Advanced Markers; defaults to DEMO_MAP_ID when unset
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Backend server origin; frontend requests always use /api/v1 prefix
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
# DeepSeek (OpenAI-compatible chat API) — server-only
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
